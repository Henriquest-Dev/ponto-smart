# Base de dados PostgreSQL com PostGIS (Neon, Supabase ou outro). Em Supabase use a ligação "pooler" (porta 6543).
DATABASE_URL=postgres://ponto:ponto@localhost:5432/pontosmart

# Segredos — gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
QR_SIGNING_SECRET=troque-por-outro-segredo-longo-e-aleatorio
CRON_SECRET=troque-por-um-segredo-para-tarefas-agendadas

# Armazenamento privado: "netlify" (Netlify Blobs) em produção, "fs" localmente.
STORAGE_DRIVER=fs

# Opcional — activa o assistente de IA (Claude).
ANTHROPIC_API_KEY=

# Testes de integração (base de dados separada; é limpa pelos testes)
TEST_DATABASE_URL=postgres://ponto:ponto@localhost:5432/pontosmart_test
